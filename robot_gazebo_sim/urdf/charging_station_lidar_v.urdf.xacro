<?xml version="1.0"?>
<robot name="charging_station_lidar_v" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="station_width" value="0.40" />  <!-- Y dimension: 40cm -->
  <xacro:property name="station_depth" value="0.20" />  <!-- X dimension: 20cm -->
  <xacro:property name="station_height" value="0.15" /> <!-- Z dimension: 15cm -->

  <!-- Materials -->
  <material name="v_station_body_mat">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>

  <material name="v_station_wing_mat">
    <color rgba="0.88 0.88 0.90 1.0"/>
  </material>

  <material name="v_station_terminal_mat">
    <color rgba="0.85 0.65 0.15 1.0"/>
  </material>

  <material name="v_station_led_mat">
    <color rgba="0.1 0.5 0.95 1.0"/>
  </material>

  <!-- Base Link / Origin on Ground Plane -->
  <link name="charging_station_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_gazebo_sim/models/charging_station_lidar_v/meshes/charging_station_lidar_v.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${station_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${station_depth} ${station_width} ${station_height}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.0125 0.0338 0.265" rpy="0 0 0.436332"/>
      <geometry>
        <box size="0.16 0.012 0.23"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.0125 -0.0338 0.265" rpy="0 0 -0.436332"/>
      <geometry>
        <box size="0.16 0.012 0.23"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${station_height/2.0}" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.30" ixy="0.0" ixz="0.0" iyy="0.10" iyz="0.0" izz="0.35"/>
    </inertial>
  </link>

  <!-- V-Shape Apex Reference Link (Useful for TF docking target verification) -->
  <link name="charging_station_v_apex_link"/>

  <joint name="charging_station_v_apex_joint" type="fixed">
    <origin xyz="-0.06 0.0 0.265" rpy="0 0 0"/>
    <parent link="charging_station_base_link"/>
    <child link="charging_station_v_apex_link"/>
  </joint>

  <!-- Gazebo static property -->
  <gazebo reference="charging_station_base_link">
    <static>true</static>
  </gazebo>

</robot>

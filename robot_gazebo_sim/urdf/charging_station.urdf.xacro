<?xml version="1.0"?>
<robot name="charging_station" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="station_width" value="0.40" />  <!-- Y dimension: 40cm -->
  <xacro:property name="station_depth" value="0.20" />  <!-- X dimension: 20cm -->
  <xacro:property name="station_height" value="0.15" /> <!-- Z dimension: 15cm -->
  <xacro:property name="tag_height" value="0.30" />     <!-- Z height of AprilTag center: 30cm -->

  <!-- Materials -->
  <material name="station_body_mat">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>

  <material name="station_terminal_mat">
    <color rgba="0.85 0.65 0.15 1.0"/>
  </material>

  <material name="station_backplate_mat">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>

  <material name="station_tag_mat">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="station_led_mat">
    <color rgba="0.1 0.9 0.2 1.0"/>
  </material>

  <!-- Base Link / Origin on Ground Plane -->
  <link name="charging_station_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_gazebo_sim/models/charging_station/meshes/charging_station.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${station_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${station_depth} ${station_width} ${station_height}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0925 0 0.265" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.24 0.23"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${station_height/2.0}" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.30" ixy="0.0" ixz="0.0" iyy="0.10" iyz="0.0" izz="0.35"/>
    </inertial>
  </link>

  <!-- AprilTag Marker Frame for TF reference and docking verification -->
  <link name="charging_station_apriltag_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.12 0.12"/>
      </geometry>
      <material name="station_tag_mat"/>
    </visual>
  </link>

  <joint name="charging_station_apriltag_joint" type="fixed">
    <origin xyz="-0.084 0.0 ${tag_height}" rpy="0 0 0"/>
    <parent link="charging_station_base_link"/>
    <child link="charging_station_apriltag_link"/>
  </joint>

  <!-- Gazebo specific static and material properties -->
  <gazebo reference="charging_station_base_link">
    <static>true</static>
  </gazebo>

  <gazebo reference="charging_station_apriltag_link">
    <material>
      <ambient>1 1 1 1</ambient>
      <diffuse>1 1 1 1</diffuse>
      <pbr>
        <metal>
          <albedo_map>model://charging_station/materials/textures/tag36h11_0.png</albedo_map>
          <roughness>0.9</roughness>
          <metalness>0.0</metalness>
        </metal>
      </pbr>
    </material>
  </gazebo>

</robot>

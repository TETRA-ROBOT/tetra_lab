<?xml version="1.0"?>
<model>
  <name>charging_station_lidar_v</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>TETRA Integration</name>
    <email>tetra@robot.com</email>
  </author>
  <description>
    TETRA Robot Charging Station with 130-degree V-Shape LiDAR Docking Object and front charging terminals.
    Target angle: 130.0 deg for line_docking_detector, covers front LiDAR scan height Z ≈ 0.27m.
    Base dimensions: Width 40cm (Y), Depth 20cm (X), Height 15cm (Z).
  </description>
</model>

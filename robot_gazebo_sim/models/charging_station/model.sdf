<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="charging_station">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    
    <link name="charging_station_link">
      <!-- Main base collision (40cm Width (Y) x 20cm Depth (X) x 15cm Height (Z)) -->
      <collision name="base_collision">
        <pose>0 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.40 0.15</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Backplate collision -->
      <collision name="backplate_collision">
        <pose>-0.0925 0 0.265 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.24 0.23</size>
          </box>
        </geometry>
      </collision>

      <!-- Main Station Visual via OBJ mesh (Body, Terminals, Backplate, Indicator LED) -->
      <visual name="station_mesh_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://charging_station/meshes/charging_station.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- High-fidelity AprilTag Visual Plate (Z=0.30m camera height, facing +X robot approach) -->
      <visual name="apriltag_marker_visual">
        <pose>-0.084 0 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>0.002 0.12 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://charging_station/materials/textures/tag36h11_0.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
